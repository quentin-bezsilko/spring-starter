# ============================================================
# Spring application
# ============================================================

SPRING_APPLICATION_NAME=springstarter


# ============================================================
# Application / Server
# ============================================================

APP_CONTAINER_NAME=springstarter
APP_PORT=8080

SERVER_PORT=8080
SERVER_CONTEXT_PATH=/springstarter


# ============================================================
# Security / JWT
# ============================================================

JWT_PUBLIC_KEY=classpath:certs/public-key.pem
JWT_ISSUER=http://localhost:8081/authstarter
JWT_AUDIENCE=springstarter-api


# ============================================================
# Shared PostgreSQL
# ============================================================

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# ============================================================
# Spring datasource
# ============================================================
# "shared-postgres" is the alias of the PostgreSQL container
# provided by springstarter-auth on springstarter-network.
# ============================================================

SPRING_DATASOURCE_URL=jdbc:postgresql://shared-postgres:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_SCHEMA=mydb


# ============================================================
# Liquibase
# ============================================================

LIQUIBASE_IMAGE=liquibase/liquibase:latest


# ============================================================
# Redis
# ============================================================

REDIS_IMAGE=redis:latest
REDIS_CONTAINER_NAME=springstarter-redis

SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379


# ============================================================
# OpenTelemetry Collector
# ============================================================

OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
OTEL_COLLECTOR_CONTAINER_NAME=springstarter-otel-collector

OTEL_SERVICE_NAME=springstarter

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=otlp


# ============================================================
# Tracing
# ============================================================

TRACING_SAMPLING_PROBABILITY=1.0


# ============================================================
# Tempo
# ============================================================

TEMPO_IMAGE=grafana/tempo:latest
TEMPO_CONTAINER_NAME=springstarter-tempo
TEMPO_PORT=3200

TEMPO_ENDPOINT=http://tempo:3200


# ============================================================
# Loki
# ============================================================

LOKI_ENDPOINT=http://loki:3100


# ============================================================
# Grafana
# ============================================================
GRAFANA_IMAGE=grafana/grafana:13.2.2
GRAFANA_CONTAINER_NAME=springstarter-grafana
GRAFANA_PORT=3000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ============================================================
# SonarQube
# ============================================================
SONARQUBE_IMAGE=sonarqube:community
SONARQUBE_CONTAINER_NAME=springstarter-sonarqube
SONARQUBE_PORT=9000


# ============================================================
# External clients
# ============================================================
TYPICODE_BASE_URL=https://jsonplaceholder.typicode.com


# ============================================================
# Cache
# ============================================================

CACHE_SAMPLES_TTL_DURATION=30m